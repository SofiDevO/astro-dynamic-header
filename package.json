{
  "name": "@sofidev/astro-dynamic-header",
  "version": "1.0.0",
  "description": "A dynamic Astro header component that switches between floating and fullscreen styles",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Header": "./src/Header.astro",
    "./NavMenu": "./src/NavMenu.astro",
    "./MobileNav": "./src/MobileNav.astro",
    "./HamburgerButton": "./src/HamburgerButton.astro",
    "./Header.astro": "./src/Header.astro",
    "./NavMenu.astro": "./src/NavMenu.astro",
    "./MobileNav.astro": "./src/MobileNav.astro",
    "./HamburgerButton.astro": "./src/HamburgerButton.astro"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "astro-package build",
    "dev": "astro-package dev",
    "check": "astro check",
    "check:watch": "astro check --watch"
  },
  "keywords": [
    "astro",
    "component",
    "header",
    "navigation",
    "responsive",
    "typescript",
    "dynamic",
    "floating",
    "sofidev",
    "fullscreen"
