  "author": "SofiDev contact@sofidev.top",
  "license": "MIT",
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "astro": "^5.12.8",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SofiDevO/astro-dynamic-header.git"
  },
  "bugs": {
