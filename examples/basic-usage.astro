---
// Ejemplo básico de uso del componente Header
import Header from '../src/Header.astro';
import type { MenuItemType } from '../src/index.ts';

const menuItems: MenuItemType[] = [
  { link: '/about', text: 'About' },
  { link: '/services', text: 'Services' },
  { link: '/contact', text: 'Contact' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Basic Header Example</title>
</head>
<body>
    <Header
        headerType="floating"
        logoSrc="/logo.png"
        logoAlt="My Company"
        menuItems={menuItems}
        backgroundColor="#0d0d0dcc"
        backdropBlur="blur(20px)"
    />

    <main style="padding-top: 100px;">
        <h1>Welcome to our website</h1>
        <p>This is an example of using the astro-dynamic-header component.</p>
    </main>
</body>
</html>
