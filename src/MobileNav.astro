---
import type { MenuItem, SecondaryMenuItem, TertiaryMenuItem } from "./index.js";
import ChevronIcon from "./ChevronIcon.astro";

export interface Props {
  /** Header type for styling: "floating" or "fullscreen" */
  type?: "floating" | "fullscreen";
  /** Array of menu items to display in the mobile menu */
  menuItems?: MenuItem[];
  /** Whether to show the home link (defaults to true) */
  showHomeLink?: boolean;
  /** Text for the home link (defaults to "Home") */
  homeText?: string;
  /** The destination URL for the home link. @default "/" */
  homeUrl?: string;
  /** Extra CSS class(es) for the root mobile `<nav>` panel. */
  mobileNav__class?: string;
}

const {
  type = "floating",
  mobileNav__class,
  menuItems = [],
  showHomeLink = true,
  homeText = "Home",
  homeUrl = "/",
} = Astro.props;

const pagePathname = Astro.url.pathname;
---

<nav
  class:list={[
    `mobile-header__menu mobile-header__menu--${type}`,
    mobileNav__class,
  ]}
  id="mobile-header-menu"
>
  <ol class="mobile-menu">
    {
      showHomeLink && pagePathname !== homeUrl && (
        <li class="header__item mobile-header__item">
          <a
            class="menu__link mobile-menu__link"
            href={homeUrl}
            data-astro-prefetch="hover"
          >
            {homeText}
          </a>
        </li>
      )
    }
    {
      menuItems?.map((item: MenuItem) => {
        const isActive = pagePathname === item.link;
        return (
          <li>
            {item.submenu ? (
              <details
                class="mobile-details"
                open={item.submenu.some((sub) => pagePathname === sub.link)}
              >
                <summary class:list={["menu__summary", { active: isActive }]}>
                  {item.text}
                  <ChevronIcon class="iconify-arrow" width={15} height={15} />
                </summary>
                <ol class="mobile-submenu">
                  {item?.submenu?.map((sub: SecondaryMenuItem) => {
                    const isSubActive = pagePathname === sub.link;
                    return (
                      <li>
                        {sub.submenu && sub.submenu.length > 0 ? (
                          <details
                            class="mobile-details"
                            open={sub.submenu.some(
                              (subsub) => pagePathname === subsub.link,
                            )}
                          >
                            <summary
                              class:list={[
                                "menu__summary",
                                { active: isSubActive },
                              ]}
                            >
                              {sub.text}
                              <ChevronIcon
                                class="iconify-arrow"
                                width={15}
                                height={15}
                              />
                            </summary>
                            <ol class="mobile-subsubmenu">
                              {sub.submenu.map((subsub: TertiaryMenuItem) => {
                                const isSubSubActive =
                                  pagePathname === subsub.link;
                                return (
                                  <li class="mobile-submenu__item secondary">
                                    <a
                                      class:list={[
                                        "menu__link",
                                        "mobile-menu__link",
                                        { active: isSubSubActive },
                                      ]}
                                      href={subsub.link}
                                    >
                                      {subsub.text}
                                    </a>
                                  </li>
                                );
                              })}
                            </ol>
                          </details>
                        ) : (
                          <a
                            class:list={[
                              "menu__link",
                              "mobile-menu__link",
                              { active: isSubActive },
                            ]}
                            href={sub.link}
                          >
                            {sub.text}
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </details>
            ) : (
              <a
                class:list={["mobile-menu__link", { active: isActive }]}
                href={item.link}
              >
                {item.text}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
  <slot name="slot-panel" />
</nav>

<style>
  @import "./styles/mobile-nav.css";
</style>
