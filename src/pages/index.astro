---
import Header from "../Header.astro";
const menuItems = [
  {
    link: "#",
    text: "Services",
    submenu: [
      { link: "/design", text: "Design" },
      { link: "/consulting", text: "Consulting" },
      {
        link: "#",
        text: "Web Development",
        submenu: [
          { link: "/web/frontend", text: "Frontend" },
          { link: "/web/backend", text: "Backend" },
          { link: "/web/fullstack", text: "Full Stack" },
        ],
      },
    ],
  },
  { link: "/about", text: "About" },
  { link: "/contact", text: "Contact" },
  {
    link: "#",
    text: "Services",
    submenu: [
      { link: "/design", text: "Design" },
      { link: "/consulting", text: "Consulting" },
      {
        link: "#",
        text: "Web Development",
        submenu: [
          { link: "/web/frontend", text: "Frontend" },
          { link: "/web/backend", text: "Backend" },
          { link: "/web/fullstack", text: "Full Stack" },
        ],
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"
    ></script>
    <title>My Astro Site with Dynamic Header</title>
  </head>
  <body>
    <Header
      headerType="floating"
      preset="dark"
      logo={{
        src: "https://itssofi.dev/img/icons/sofi-icon.webp",
        alt: "My Site Logo",
        width: "44px",
      }}
      navigation={{
        homeUrl: "/",
        menuItems: menuItems,
      }}
      theme={{
        light: {
          accentColor: "#3e1c71",
        },
        dark: {
          accentColor: "#00ffff",
          backgroundColor: "rgba(20, 20, 20, 0.8)",
        },
      }}
    >
      <button slot="actions">same btn</button>
    </Header>
    <main>
      <h2>Hello World</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod.
      </p>
    </main>
  </body>
</html>

<style is:inline>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ul {
    margin: 0;
    padding: 0;
  }
  ul li {
    list-style: none;
  }
  .desktop {
    display: block;
  }
  .mobile {
    display: none;
  }
  @media screen and (max-width: 767px) {
    .desktop {
      display: none;
    }
    .mobile {
      display: block;
      color: white;
    }
  }
  main {
    margin-top: 40rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
  }
</style>
