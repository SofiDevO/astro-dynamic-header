---
import Header from "../Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Install from "../components/Install.astro";
import UsageExamples from "../components/UsageExamples.astro";
import Footer from "../components/Footer.astro";
import SunIcon from "../SunIcon.astro";
import MoonIcon from "../MoonIcon.astro";
import type { MenuItem } from "../index.js";

import Docs from "../../README.md";

const menuItems: MenuItem[] = [
  {
    link: "#",
    text: "Services",
    submenu: [
      { link: "/design", text: "Design" },
      { link: "/consulting", text: "Consulting" },
      {
        link: "#",
        text: "Web Development",
        submenu: [
          { link: "/web/frontend", text: "Frontend" },
          { link: "/web/backend", text: "Backend" },
          { link: "/web/fullstack", text: "Full Stack" },
        ],
      },
    ],
  },
  { link: "/about", text: "About" },
  { link: "/blog", text: "Blog" },
  { link: "/contact", text: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="astro-dynamic-header — a zero-dependency responsive Astro header with multi-level dropdowns."
    />
    <title>astro-dynamic-header — Demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ── Header component ─────────────────────────────────────────── -->
    <Header
      headerType="fullscreen"
      navigation={{ homeUrl: "/", menuItems }}
      classNames={{ header: "demo-pill" }}
    >
      <a slot="logo" href="/" class="header-logo">
        <img
          src="https://itssofi.dev/img/icons/sofi-icon.webp"
          alt="SofiDev Logo"
          width="44"
          height="44"
        />
        <span>SofiDev</span>
      </a>
      <div slot="actions" class="header-actions">
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <SunIcon class="sun-icon" />
          <MoonIcon class="moon-icon" />
        </button>
        <button
          id="layout-toggle"
          type="button"
          title="Switch header layout"
          aria-label="Switch to fullscreen layout"
        >
          <span id="layout-toggle-label">Floating</span>
        </button>
        <a
          href="https://www.npmjs.com/package/@sofidevo/astro-dynamic-header"
          target="_blank"
          class="btn-cta">Get started</a
        >
      </div>
    </Header>

    <!-- ── Isolated Sections ── -->
    <Hero />
    <Features />
    <Install />
    <UsageExamples />
    <div id="container-post">
      <Docs />
    </div>
    <Footer />
  </body>
</html>

<script>
  // Simple dark-mode toggle for the demo
  const toggle = document.querySelectorAll("#theme-toggle");
  toggle.forEach((element) => {
    element.addEventListener("click", () => {
      const html = document.documentElement;
      const isDark = html.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  });

  const html = document.documentElement;

  // Restore saved preference
  if (localStorage.getItem("theme") === "dark") {
    html.classList.add("dark");
  }

  // ── Header layout toggle (demo only) ──────────────────────────────
  // `headerType` is a server-rendered prop, so the demo swaps the
  // component's layout modifiers at runtime instead of re-rendering.
  const layoutTargets: Array<[selector: string, baseClass: string]> = [
    [".header__container", "header__container"],
    ["header.header", "header"],
    ["#mobile-header-menu", "mobile-header__menu"],
  ];

  let layout: "floating" | "fullscreen" =
    localStorage.getItem("layout") === "fullscreen" ? "fullscreen" : "floating";

  function applyLayout(): void {
    const suffix = `--${layout}`;
    const label = layout === "floating" ? "Floating" : "Fullscreen";
    const next = layout === "floating" ? "fullscreen" : "floating";

    layoutTargets.forEach(([selector, baseClass]) => {
      const element = document.querySelector(selector);
      if (!element) return;
      element.classList.remove(
        `${baseClass}--floating`,
        `${baseClass}--fullscreen`,
      );
      element.classList.add(`${baseClass}${suffix}`);
    });

    html.classList.toggle("layout-fullscreen", layout === "fullscreen");

    document.querySelectorAll("#layout-toggle-label").forEach((node) => {
      node.textContent = label;
    });
    document.querySelectorAll("#layout-toggle").forEach((node) => {
      node.setAttribute("aria-label", `Switch to ${next} layout`);
    });
  }

  applyLayout();

  document.querySelectorAll("#layout-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      layout = layout === "floating" ? "fullscreen" : "floating";
      localStorage.setItem("layout", layout);
      applyLayout();
    });
  });
</script>

<style is:inline>
  /*
   * Cascade layers mirror what a real consumer does (e.g. Tailwind):
   *   base (resets) < components (the Header) < utilities (classNames)
   */
  @layer theme, base, components, utilities;

  @layer base {
    /* ── Reset & tokens ── */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ul,
    ol {
      list-style: none;
    }
  }

  :root {
    --bg: #f8f7ff;
    --bg-card: #ffffff;
    --text: #1a1a2e;
    --text-muted: #6b7280;
    --border: rgba(0, 0, 0, 0.08);
    --radius: 16px;
    --shadow: 0 4px 24px rgba(124, 58, 237, 0.08);
    font-family: "Inter", system-ui, sans-serif;

    /* Native CSS Variables customization of the component */
    --l-accent: #7c3aed;
    --l-bg: rgba(255, 255, 255, 0.753);
    --l-bg-opaque: #ffffff;
    --l-text: #1a1a1a;

    --d-accent: #a78bfa;
    --d-bg: rgba(10, 10, 10, 0.85);
    --d-bg-opaque: #0a0a0a;
    --d-text: #f5f5f5;
  }

  html,
  body {
    display: flex;
    width: 100%;
    overflow-x: hidden;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  code {
    font-family: "Fira Code", "Cascadia Code", monospace;
    font-size: 0.88em;
    background: rgba(124, 58, 237, 0.1);
    color: var(--l-accent);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  /* ── Header custom components styles ── */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 8px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  #theme-toggle:hover {
    transform: rotate(15deg) scale(1.15);
  }
  #theme-toggle svg {
    stroke: var(--text);
    transition: stroke 0.3s ease;
  }

  /* Sun/moon toggle display logic */
  html.dark #theme-toggle .sun-icon {
    display: none;
  }
  html.dark #theme-toggle .moon-icon {
    display: block;
  }
  html:not(.dark) #theme-toggle .sun-icon {
    display: block;
  }
  html:not(.dark) #theme-toggle .moon-icon {
    display: none;
  }

  #layout-toggle {
    background: transparent;
    border: 1px solid var(--border);
    color: inherit;
    cursor: pointer;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  #layout-toggle:hover {
    border-color: var(--l-accent);
    color: var(--l-accent);
  }

  .btn-cta {
    background: var(--l-accent);
    color: #fff;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .btn-cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* Dark mode overrides for page */
  .dark {
    --bg: #080710;
    --bg-card: #0d0c15;
    --text: #f5f5fa;
    --text-muted: #9ca3af;
    --border: rgba(255, 255, 255, 0.06);
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  /*
   * Proof of the fix: the Header's own CSS lives in `components`, this
   * utility lives in `utilities`, so `.demo-pill` wins without `!important`.
   * It is passed to the component via classNames={{ header: "demo-pill" }}.
   */
  @layer utilities {
    .demo-pill {
      /* background: rgba(0, 255, 213, 0.435); */
      /* border-radius: 999px; */
      /* backdrop-filter: blur(4px); */
      box-shadow: 0 3px 20px rgba(148, 100, 231, 0.31);
    }

    /*
     * In fullscreen the demo hands the squared look back to the component:
     * .demo-pill (utilities) still beats .header--fullscreen (components),
     * so the demo opts its own utility out explicitly.
     */
    html.layout-fullscreen .demo-pill {
      border-radius: 0;
    }
  }
</style>

<style is:inline>
  /* ── Docs scope ───────────────────────────────────────── */
  #container-post {
    /* Accent alias: the demo splits accent in --l-accent / --d-accent */
    --accent-color: var(--l-accent);
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    gap:3rem;
  }

  html.dark #container-post {
    --accent-color: var(--d-accent);
  }

  /* ── Headings ─────────────────────────────────────────── */
  #container-post h1,
  #container-post h2,
  #container-post h3,
  #container-post h4,
  #container-post h5,
  #container-post h6 {
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
    margin-top: 2em;
    margin-bottom: 0.5em;
    scroll-margin-top: 6rem;
  }

  #container-post h1 {
    font-size: 2rem;
    margin-top: 0.5em;
  }

  #container-post h2 {
    font-size: 1.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--accent-color) 40%, transparent);
    padding-bottom: 0.25em;
  }

  #container-post h3 {
    font-size: 1.375rem;
  }
  #container-post h4 {
    font-size: 1.125rem;
  }
  #container-post h5 {
    font-size: 1rem;
  }
  #container-post h6 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* ── Paragraphs ───────────────────────────────────────── */
  #container-post p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1.25em;
  }

  /* ── Links ────────────────────────────────────────────── */
  #container-post a {
    color: var(--accent-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent-color) 40%, transparent);
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }

  #container-post a:hover {
    color: color-mix(in srgb, var(--accent-color) 80%, var(--text));
    text-decoration-color: currentColor;
  }

  /* ── Lists ────────────────────────────────────────────── */
  #container-post ul,
  #container-post ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25em;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  #container-post ul {
    list-style-type: disc;
  }
  #container-post ol {
    list-style-type: decimal;
  }

  #container-post li {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
  }

  #container-post li::marker {
    color: var(--accent-color);
  }

  #container-post li > ul,
  #container-post li > ol {
    margin: 0.35em 0 0;
  }

  /* ── Blockquote / GitHub alerts ───────────────────────── */
  #container-post blockquote {
    border-left: 4px solid var(--accent-color);
    padding: 0.75em 1.25em;
    margin: 1.5em 0;
    background-color: color-mix(in srgb, var(--accent-color) 8%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--text-muted);
  }

  #container-post blockquote p {
    margin-bottom: 0.5em;
  }

  #container-post blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Alert type label rendered by GitHub-style alerts: [!NOTE] … */
  #container-post blockquote p:first-child > strong:first-child {
    color: var(--accent-color);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* ── Code ─────────────────────────────────────────────── */
  #container-post code {
    font-family: ui-monospace, "Cascadia Code", "Fira Code", monospace;
    font-size: 0.875em;
    background-color: color-mix(in srgb, var(--accent-color) 10%, transparent);
    color: var(--text);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    word-break: break-word;
  }

  #container-post pre {
    background-color: var(--bg-card);
    color: var(--text);
    padding: 1.25em 1.5em;
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
    margin-bottom: 1.5em;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    tab-size: 2;
  }

  #container-post pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
    border-radius: 0;
    word-break: normal;
  }

  /* ── Horizontal rule ──────────────────────────────────── */
  #container-post hr {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--accent-color) 25%, transparent);
    margin: 2.5em 0;
  }

  /* ── Images ───────────────────────────────────────────── */
  #container-post img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  /* ── Figure / caption ─────────────────────────────────── */
  #container-post figure {
    margin: 1.5em 0;
  }

  #container-post figcaption {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5em;
    font-style: italic;
  }

  /* ── Strong / emphasis ────────────────────────────────── */
  #container-post strong {
    font-weight: 700;
    color: var(--text);
  }

  #container-post em {
    font-style: italic;
    color: var(--text);
  }

  /* ── Table ────────────────────────────────────────────── */
  #container-post table {
    /* display:block + overflow lets wide markdown tables scroll on
       small screens without an extra wrapper element */
    display: block;
    width: fit-content;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9rem;
    margin-bottom: 1.5em;
    border: 1px solid color-mix(in srgb, var(--accent-color) 18%, transparent);
    border-radius: 0.75rem;
    background-color: var(--bg-card);
  }

  #container-post thead th {
    background-color: rebeccapurple;
    width 100%
    color: #fff;
    font-weight: 600;
    padding: 0.7em 1em;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid color-mix(in srgb, var(--accent-color) 30%, transparent);
  }

  #container-post tbody td {

    padding: 0.65em 1em;
    border-bottom: 1px solid
      color-mix(in srgb, var(--accent-color) 12%, transparent);
    color: var(--text);
    vertical-align: top;
  }

  #container-post tbody tr:last-child td {
    border-bottom: none;
  }

  #container-post tbody tr:nth-child(even) td {
    background-color: color-mix(in srgb, var(--accent-color) 4%, transparent);
  }

  #container-post tbody tr:hover td {
    background-color: color-mix(in srgb, var(--accent-color) 10%, transparent);
  }

  /* Inline code inside cells keeps the accent tint */
  #container-post td code,
  #container-post th code {
    white-space: nowrap;
  }
</style>
