---
import Header from '../Header.astro'

const menuItems = [
  {
    link: '#',
    text: 'Services',
    submenu: [
      { link: '/design', text: 'Design' },
      { link: '/consulting', text: 'Consulting' },
      {
        link: '#',
        text: 'Web Development',
        submenu: [
          { link: '/web/frontend', text: 'Frontend' },
          { link: '/web/backend', text: 'Backend' },
          { link: '/web/fullstack', text: 'Full Stack' },
        ],
      },
    ],
  },
  { link: '/about', text: 'About' },
  { link: '/contact', text: 'Contact' },
  {
    link: '#',
    text: 'Services',
    submenu: [
      { link: '/design', text: 'Design' },
      { link: '/consulting', text: 'Consulting' },
      {
        link: '#',
        text: 'Web Development',
        submenu: [
          { link: '/web/frontend', text: 'Frontend' },
          { link: '/web/backend', text: 'Backend' },
          { link: '/web/fullstack', text: 'Full Stack' },
        ],
      },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"
    ></script>
    <title>My Astro Site with Dynamic Header</title>
  </head>
  <body>
    <Header
      headerType="floating"
      preset="dark"
      navigation={{
        homeUrl: '/',
        menuItems: menuItems,
        header__menu__class: 'custom-menu-wrapper',
        header__item__class: 'custom-menu-item',
        menu__link__class: 'custom-menu-link',
      }}
      classNames={{
        header: 'custom-header-wrapper',
        container: 'custom-container',
        mobileNav: 'custom-mobile-nav',
      }}
    >
      <a
        slot="logo"
        href="/"
        style="display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none;"
      >
        <img
          src="https://sofidev.blog/img/branding/logo.webp
"
          alt="My Site Logo"
          width="44"
        />
        <span style="font-weight: bold; font-size: 1.2rem;">SofiDev</span>
      </a>
      <button slot="actions">same btn</button>
    </Header>
    <main>
      <h2>Hello World</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod.
      </p>
    </main>
  </body>
</html>

<style is:inline>
  :root {
    /* Nueva personalización vía CSS Variables (sin necesidad de objeto JS) */
    --l-accent: #ff0000;
    --l-bg: rgba(255, 255, 255, 0.8);

    --d-accent: #00ffff;
    --d-bg: rgba(20, 20, 20, 0.9);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ul {
    margin: 0;
    padding: 0;
  }
  ul li {
    list-style: none;
  }
  .desktop {
    display: block;
  }
  .mobile {
    display: none;
  }
  @media screen and (max-width: 767px) {
    .desktop {
      display: none;
    }
    .mobile {
      display: block;
      color: white;
    }
  }
  main {
    margin-top: 40rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
  }
</style>
