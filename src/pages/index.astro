---
import Header from "../Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Install from "../components/Install.astro";
import UsageExamples from "../components/UsageExamples.astro";
import Footer from "../components/Footer.astro";
import SunIcon from "../SunIcon.astro";
import MoonIcon from "../MoonIcon.astro";
import type { MenuItem } from "../index.js";

import "./styles/base.css";
import "./styles/header-demo.css";
import "./styles/docs.css";

import Docs from "../../README.md";

const menuItems: MenuItem[] = [
  {
    link: "#",
    text: "Services",
    submenu: [
      { link: "/design", text: "Design" },
      { link: "/consulting", text: "Consulting" },
      {
        link: "#",
        text: "Web Development",
        submenu: [
          { link: "/web/frontend", text: "Frontend" },
          { link: "/web/backend", text: "Backend" },
          { link: "/web/fullstack", text: "Full Stack" },
        ],
      },
    ],
  },
  { link: "/about", text: "About" },
  { link: "/blog", text: "Blog" },
  { link: "/contact", text: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="astro-dynamic-header — a zero-dependency responsive Astro header with multi-level dropdowns."
    />
    <title>astro-dynamic-header — Demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ── Header component ─────────────────────────────────────────── -->
    <Header
      headerType="fullscreen"
      navigation={{ homeUrl: "/", menuItems }}
      classNames={{
        header: "demo-pill",
      }}
    >
      <a slot="logo" href="/" class="header-logo">
        <img
          src="https://itssofi.dev/img/icons/sofi-icon.webp"
          alt="SofiDev Logo"
          width="44"
          height="44"
        />
        <span>SofiDev</span>
      </a>
      <div slot="actions" class="header-actions">
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <SunIcon class="sun-icon" />
          <MoonIcon class="moon-icon" />
        </button>
        <button
          id="layout-toggle"
          type="button"
          title="Switch header layout"
          aria-label="Switch to fullscreen layout"
        >
          <span id="layout-toggle-label">Floating</span>
        </button>
        <a
          href="https://www.npmjs.com/package/@sofidevo/astro-dynamic-header"
          target="_blank"
          class="btn-cta">Get started</a
        >
      </div>
    </Header>

    <!-- ── Isolated Sections ── -->
    <Hero />
    <Features />
    <Install />
    <UsageExamples />
    <div id="container-post">
      <Docs />
    </div>
    <Footer />
  </body>
</html>

<script>
  const toggle = document.querySelectorAll("#theme-toggle");
  toggle.forEach((element) => {
    element.addEventListener("click", () => {
      const html = document.documentElement;
      const isDark = html.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  });

  const html = document.documentElement;


  if (localStorage.getItem("theme") === "dark") {
    html.classList.add("dark");
  }

  // ── Header layout toggle (demo only) ──────────────────────────────
  // `headerType` is a server-rendered prop, so the demo swaps the
  // component's layout modifiers at runtime instead of re-rendering.
  const layoutTargets: Array<[selector: string, baseClass: string]> = [
    [".header__container", "header__container"],
    ["header.header", "header"],
    ["#mobile-header-menu", "mobile-header__menu"],
  ];

  let layout: "floating" | "fullscreen" =
    localStorage.getItem("layout") === "fullscreen" ? "fullscreen" : "floating";

  function applyLayout(): void {
    const suffix = `--${layout}`;
    const label = layout === "floating" ? "Floating" : "Fullscreen";
    const next = layout === "floating" ? "fullscreen" : "floating";

    layoutTargets.forEach(([selector, baseClass]) => {
      const element = document.querySelector(selector);
      if (!element) return;
      element.classList.remove(
        `${baseClass}--floating`,
        `${baseClass}--fullscreen`,
      );
      element.classList.add(`${baseClass}${suffix}`);
    });

    html.classList.toggle("layout-fullscreen", layout === "fullscreen");

    document.querySelectorAll("#layout-toggle-label").forEach((node) => {
      node.textContent = label;
    });
    document.querySelectorAll("#layout-toggle").forEach((node) => {
      node.setAttribute("aria-label", `Switch to ${next} layout`);
    });
  }

  applyLayout();

  document.querySelectorAll("#layout-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      layout = layout === "floating" ? "fullscreen" : "floating";
      localStorage.setItem("layout", layout);
      applyLayout();
    });
  });
</script>
