---
import HamburgerButton from "./HamburgerButton.astro";
import NavMenu from "./NavMenu.astro";
import MobileNav from "./MobileNav.astro";

import type { NavConfig, HeaderClassNames } from "./index.js";

export interface Props {
  /**
   * Layout style of the header.
   * - `"floating"` — centered, max width, rounded corners (default).
   * - `"fullscreen"` — full width, no border radius.
   *
   * @default "floating"
   * @example
   * ```astro
   * <Header headerType="fullscreen" />
   * ```
   */
  headerType?: "floating" | "fullscreen";

  /**
   * Theme behavior of the header.
   * - `"auto"` (default) — follows the `.dark` class on the root element.
   * - `"light"` — always render the light theme (`header--force-light`).
   * - `"dark"` — always render the dark theme (`header--force-dark`).
   * -  `"none"` - disable completely the preset
   *
   * Colors are controlled with CSS variables (see the README "CSS variable
   * reference"), never with props.
   *
   * @default "auto"
   * @example
   * ```astro
   * <Header preset="dark" />
   * ```
   */
  preset?: "light" | "dark" | "auto" | "none";

  /**
   * Navigation links, home link, and fine-grained classes for the desktop
   * menu items.
   *
   * @example
   * ```astro
   * <Header
   *   navigation={{
   *     menuItems: [
   *       { link: "/about", text: "About" },
   *       { link: "/work", text: "Work", submenu: [{ link: "/ux", text: "UX" }] },
   *     ],
   *     menu__link__class: "hover:text-purple-400",
   *   }}
   * />
   * ```
   */
  navigation?: NavConfig;

  /**
   * CSS classes for the structural wrapper elements. The component styles
   * live in `@layer components`, so any class passed here — Tailwind
   * utilities included — wins over the built-in styles without `!important`.
   *
   * @example
   * ```astro
   * <Header classNames={{ header: "bg-red-500 shadow-xl", container: "top-4" }} />
   * ```
   *
   * With plain CSS, put your own class in `@layer utilities` so it beats the
   * component:
   *
   * ```astro
   * <Header classNames={{ header: "custom-header-bg" }} />
   * <style is:inline>
   *   @layer utilities {
   *     .custom-header-bg { background-color: red; }
   *   }
   * </style>
   * ```
   */
  classNames?: HeaderClassNames;
}

const {
  headerType = "floating",
  preset = "auto",
  navigation = {},
  classNames = {},
} = Astro.props;

// Navigation configuration
const {
  homeUrl = "/",
  menuItems = [],
  header__menu__class,
  header__item__class,
  menu__link__class,
} = navigation;

let forcedClass = "";
if (preset !== "none") {
  forcedClass = `header--force-${preset}`;
}
---

<style is:inline>
  @layer theme, base, components, utilities;
</style>

<script>
  import { initHamburger } from "./scripts/hamburger.js";
  import { initLayerDiagnostics } from "./scripts/layer-diagnostics.js";

  initHamburger();

  if (import.meta.env.DEV) {
    initLayerDiagnostics();
  }
</script>

<div
  class:list={[
    "header__container",
    `header__container--${headerType}`,
    classNames.container,
  ]}
>
  <header
    class:list={[
      classNames.header,
      "header",
      `header--${headerType}`,
      forcedClass,
    ]}
  >
    <slot name="logo" />

    <div class:list={[classNames.nav, "nav-menu-wrapper"]}>
      <NavMenu
        menuItems={menuItems}
        homeUrl={homeUrl}
        header__menu__class={header__menu__class}
        header__item__class={header__item__class}
        menu__link__class={menu__link__class}
      />
    </div>

    {
      Astro.slots.has("actions") && (
        <div class="actions-desktop">
          <slot name="actions" />
        </div>
      )
    }

    <HamburgerButton />

    <MobileNav
      menuItems={menuItems}
      homeUrl={homeUrl}
      type={headerType}
      mobileNav__class={classNames.mobileNav}
    >
      {
        Astro.slots.has("actions") && (
          <div class="actions-mobile" slot="slot-panel">
            <slot name="actions" />
          </div>
        )
      }
    </MobileNav>
  </header>
</div>

<style>
  @import "./styles/header.css";
</style>
