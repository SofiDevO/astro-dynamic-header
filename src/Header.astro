---
import HamburgerButton from "./HamburgerButton.astro";
import NavMenu from "./NavMenu.astro";
import MobileNav from "./MobileNav.astro";

import type {
  NavConfig,
  DualThemeConfig,
  HeaderClassNames,
} from "./index.js";

export interface Props {
  /**
   * Layout style.
   * - "floating": Centered with max-width and rounded corners.
   * - "fullscreen": Full width with no border radius.
   * @default "floating"
   */
  headerType?: "floating" | "fullscreen";
  /**
   * Theme behavior.
   * - "light": Force light mode.
   * - "dark": Force dark mode.
   * - "auto": Detects .dark class on the root element.
   * @default "auto"
   */
  preset?: "light" | "dark" | "auto";

  /** Navigation links and structure. */
  navigation?: NavConfig;
  /** Custom theme overrides for light and dark modes. */
  theme?: DualThemeConfig;
  /**
   * High-level CSS class overrides for structural wrapper elements.
   * For fine-grained nav/logo element classes, use the nested `xxx__class`
   * props inside `navigation` or `logo` instead.
   * @example { header: "shadow-lg", container: "top-4" }
   */
  classNames?: HeaderClassNames;
}

const {
  headerType = "floating",
  preset = "auto",

  navigation = {},
  theme = {},
  classNames = {},
} = Astro.props;

if (import.meta.env.DEV) {

  if (Array.isArray(navigation)) {
    console.warn(
      "[@sofidevo/astro-dynamic-header] BREAKING CHANGE: The 'navigation' prop now expects an object with 'menuItems'. Please use navigation={{ menuItems: [...] }} instead.",
    );
  }
}

// Map user theme overrides to CSS custom properties
const inlineStyles: Record<string, string> = {};

if (theme.light) {
  if (theme.light.backgroundColor) inlineStyles["--l-bg"] = theme.light.backgroundColor;
  if (theme.light.backgroundColorOpaque) inlineStyles["--l-bg-opaque"] = theme.light.backgroundColorOpaque;
  if (theme.light.textColor) inlineStyles["--l-text"] = theme.light.textColor;
  if (theme.light.accentColor) inlineStyles["--l-accent"] = theme.light.accentColor;
  if (theme.light.backdropBlur) inlineStyles["--l-blur"] = theme.light.backdropBlur;
}
if (theme.dark) {
  if (theme.dark.backgroundColor) inlineStyles["--d-bg"] = theme.dark.backgroundColor;
  if (theme.dark.backgroundColorOpaque) inlineStyles["--d-bg-opaque"] = theme.dark.backgroundColorOpaque;
  if (theme.dark.textColor) inlineStyles["--d-text"] = theme.dark.textColor;
  if (theme.dark.accentColor) inlineStyles["--d-accent"] = theme.dark.accentColor;
  if (theme.dark.backdropBlur) inlineStyles["--d-blur"] = theme.dark.backdropBlur;
}

const zIndex = theme.light?.zIndex ?? 10;

// Navigation configuration
const {
  homeUrl = "/",
  menuItems = [],
  header__menu__class,
  header__item__class,
  menu__link__class,
} = navigation;



const forcedClass = preset !== "auto" ? `header--force-${preset}` : "";
---

<script>
  class HamburgerController {
    private hamburgerBtn: HTMLElement | null;
    private mobileMenu: HTMLElement | null;
    private links: NodeListOf<HTMLElement>;

    constructor() {
      this.hamburgerBtn = document.getElementById("hamburger-btn");
      this.mobileMenu = document.getElementById("mobile-header-menu");
      this.links = document.querySelectorAll(".mobile-menu__link");
      this.init();
    }

    private init(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.addEventListener("click", () => this.toggleMenu());
        this.links.forEach((link) => {
          link.addEventListener("click", () => this.closeMenu());
        });
      }
    }

    private closeMenu(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.classList.remove("is-active");
        this.mobileMenu.classList.remove("is-active");
      }
    }

    private toggleMenu(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.classList.toggle("is-active");
        this.mobileMenu.classList.toggle("is-active");
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new HamburgerController();
  });
</script>

<div
  class:list={[
    "header__container",
    `header__container--${headerType}`,
    classNames.container,
  ]}
  style={{ zIndex }}
>
  <header
    class:list={[
      "header",
      `header--${headerType}`,
      forcedClass,
      classNames.header,
    ]}
    style={Object.keys(inlineStyles).length > 0 ? inlineStyles : undefined}
  >
    <slot name="logo" />

    <div class:list={["nav-menu-wrapper", classNames.nav]}>
      <NavMenu
        menuItems={menuItems}
        homeUrl={homeUrl}
        header__menu__class={header__menu__class}
        header__item__class={header__item__class}
        menu__link__class={menu__link__class}
      />
    </div>

    {
      Astro.slots.has("actions") && (
        <div class="actions-desktop">
          <slot name="actions" />
        </div>
      )
    }

    <HamburgerButton />

    <MobileNav
      menuItems={menuItems}
      homeUrl={homeUrl}
      type={headerType}
      mobileNav__class={classNames.mobileNav}
    >
      {
        Astro.slots.has("actions") && (
          <div class="actions-mobile" slot="slot-panel">
            <slot name="actions" />
          </div>
        )
      }
    </MobileNav>
  </header>
</div>

<style is:inline>
  .header {
    --bg-color: var(--l-bg, rgba(255, 255, 255, 0.9));
    --bg-color-opaque: var(--l-bg-opaque, rgb(255, 255, 255));
    --text-color: var(--l-text, #1a1a1a);
    --accent-color: var(--l-accent, #3e1c71);
    --backdrop-blur: var(--l-blur, blur(20px));

    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    padding: 1em 2em;
    background-color: var(--bg-color);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    color: var(--text-color);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;

    @media (width < 768px) {
      align-self: flex-end;
      padding: 0.4em;
      margin: 0 auto;
    }
  }

  /* Automatic dark mode detection via root class */
  :root.dark .header:not(.header--force-light) {
    --bg-color: var(--d-bg, #0d0d0dcc);
    --bg-color-opaque: var(--d-bg-opaque, #0d0d0d);
    --text-color: var(--d-text, #ffffff);
    --accent-color: var(--d-accent, #00ffff);
    --backdrop-blur: var(--d-blur, blur(20px));
  }

  /* Forced themes */
  .header--force-dark {
    --bg-color: var(--d-bg, #0d0d0dcc) !important;
    --bg-color-opaque: var(--d-bg-opaque, #0d0d0d) !important;
    --text-color: var(--d-text, #ffffff) !important;
    --accent-color: var(--d-accent, #00ffff) !important;
    --backdrop-blur: var(--d-blur, blur(20px)) !important;
  }

  .header--force-light {
    --bg-color: var(--l-bg, rgba(255, 255, 255, 0.9)) !important;
    --bg-color-opaque: var(--l-bg-opaque, rgb(255, 255, 255)) !important;
    --text-color: var(--l-text, #1a1a1a) !important;
    --accent-color: var(--l-accent, #3e1c71) !important;
    --backdrop-blur: var(--l-blur, blur(20px)) !important;
  }

  .header__container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    position: fixed;

    @media (width < 768px) {
      justify-content: flex-end;
      align-items: flex-end;
    }
  }

  .header__container--floating {
    padding: 0.5em;
  }

  .header__container--fullscreen {
    padding: 0;
  }

  .header--floating {
    max-width: 1100px;
    border-radius: 20px;
    padding: 0.7em 1em;

    @media (width < 768px) {
      max-width: 95%;
    }
  }

  .header--fullscreen {
    border-radius: 0;
    padding: 1em 2em;

    @media (width < 768px) {
      max-width: 100%;
      padding: 0.8em 1em;
    }
  }



  .actions-desktop {
    @media (width < 768px) {
      display: none;
    }
  }

  .actions-mobile {
    margin-top: 20px;
    @media (width >= 768px) {
      display: none;
    }
  }

  .header--fullscreen .mobile-header__menu.is-active {
    transform: translate(0%);
  }
</style>
