---
import HamburgerButton from "./HamburgerButton.astro";
import NavMenu from "./NavMenu.astro";
import MobileNav from "./MobileNav.astro";
import { defaultThemes } from "./defaults.js";

import type {
  LogoConfig,
  NavConfig,
  DualThemeConfig,
  HeaderClassNames,
} from "./index.js";

export interface Props {
  /**
   * Layout style.
   * - "floating": Centered with max-width and rounded corners.
   * - "fullscreen": Full width with no border radius.
   * @default "floating"
   */
  headerType?: "floating" | "fullscreen";
  /**
   * Theme behavior.
   * - "light": Force light mode.
   * - "dark": Force dark mode.
   * - "auto": Detects .dark class on the root element.
   * @default "auto"
   */
  preset?: "light" | "dark" | "auto";
  /** Logo configuration object (src, alt, text, etc.) */
  logo?: LogoConfig;
  /** Navigation links and structure. */
  navigation?: NavConfig;
  /** Custom theme overrides for light and dark modes. */
  theme?: DualThemeConfig;
  /**
   * High-level CSS class overrides for structural wrapper elements.
   * For fine-grained nav/logo element classes, use the nested `xxx__class`
   * props inside `navigation` or `logo` instead.
   * @example { header: "shadow-lg", container: "top-4" }
   */
  classNames?: HeaderClassNames;
}

const {
  headerType = "floating",
  preset = "auto",
  logo = {},
  navigation = {},
  theme = {},
  classNames = {},
} = Astro.props;

if (import.meta.env.DEV) {
  if (typeof logo === "string") {
    console.warn(
      "[@sofidevo/astro-dynamic-header] BREAKING CHANGE: The 'logo' prop now expects an object. Please use logo={{ src: '...' }} instead.",
    );
  }
  if (Array.isArray(navigation)) {
    console.warn(
      "[@sofidevo/astro-dynamic-header] BREAKING CHANGE: The 'navigation' prop now expects an object with 'menuItems'. Please use navigation={{ menuItems: [...] }} instead.",
    );
  }
}

// Merge user theme overrides with defaults
const lightTheme = { ...defaultThemes.light, ...theme.light };
const darkTheme = { ...defaultThemes.dark, ...theme.dark };

// Navigation configuration
const {
  homeUrl = "/",
  menuItems = [],
  header__menu__class,
  header__item__class,
  menu__link__class,
} = navigation;

// Logo configuration
const {
  src: logoSrc = "/logo.png",
  alt: logoAlt = "Logo",
  width: logoWidth = "55px",
  text: logoText = "",
  textSize: logoTextSize = "1em",
  textColor: logoTextColor = "inherit", // Will inherit from theme text-color
  logo__container__class,
  logo__text__class,
} = logo;

const forcedClass = preset !== "auto" ? `header--force-${preset}` : "";
---

<script>
  class HamburgerController {
    private hamburgerBtn: HTMLElement | null;
    private mobileMenu: HTMLElement | null;
    private links: NodeListOf<HTMLElement>;

    constructor() {
      this.hamburgerBtn = document.getElementById("hamburger-btn");
      this.mobileMenu = document.getElementById("mobile-header-menu");
      this.links = document.querySelectorAll(".mobile-menu__link");
      this.init();
    }

    private init(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.addEventListener("click", () => this.toggleMenu());
        this.links.forEach((link) => {
          link.addEventListener("click", () => this.closeMenu());
        });
      }
    }

    private closeMenu(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.classList.remove("is-active");
        this.mobileMenu.classList.remove("is-active");
      }
    }

    private toggleMenu(): void {
      if (this.hamburgerBtn && this.mobileMenu) {
        this.hamburgerBtn.classList.toggle("is-active");
        this.mobileMenu.classList.toggle("is-active");
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new HamburgerController();
  });
</script>

<div
  class:list={[
    "header__container",
    `header__container--${headerType}`,
    classNames.container,
  ]}
  style={{ zIndex: lightTheme.zIndex }}
>
  <header
    class:list={[
      "header",
      `header--${headerType}`,
      forcedClass,
      classNames.header,
    ]}
    style={{
      "--l-bg": lightTheme.backgroundColor,
      "--l-bg-opaque": lightTheme.backgroundColorOpaque,
      "--l-text": lightTheme.textColor,
      "--l-accent": lightTheme.accentColor,
      "--l-blur": lightTheme.backdropBlur,
      "--d-bg": darkTheme.backgroundColor,
      "--d-bg-opaque": darkTheme.backgroundColorOpaque,
      "--d-text": darkTheme.textColor,
      "--d-accent": darkTheme.accentColor,
      "--d-blur": darkTheme.backdropBlur,
    }}
  >
    <a
      class:list={["logo__container", logo__container__class, classNames.logo]}
      href={homeUrl}
    >
      <img
        class="header__logo"
        src={logoSrc}
        alt={logoAlt}
        style={{ width: logoWidth }}
      />
      {
        logoText && (
          <span
            class:list={[
              "header__logo-text",
              logo__text__class,
              classNames.logoText,
            ]}
            style={{ color: logoTextColor, fontSize: logoTextSize }}
          >
            {logoText}
          </span>
        )
      }
    </a>

    <div class:list={["nav-menu-wrapper", classNames.nav]}>
      <NavMenu
        menuItems={menuItems}
        header__menu__class={header__menu__class}
        header__item__class={header__item__class}
        menu__link__class={menu__link__class}
      />
    </div>

    {
      Astro.slots.has("actions") && (
        <div class="actions-desktop">
          <slot name="actions" />
        </div>
      )
    }

    <HamburgerButton color={lightTheme.textColor} />

    <MobileNav
      menuItems={menuItems}
      type={headerType}
      mobileNav__class={classNames.mobileNav}
    >
      {
        Astro.slots.has("actions") && (
          <div class="actions-mobile" slot="slot-panel">
            <slot name="actions" />
          </div>
        )
      }
    </MobileNav>
  </header>
</div>

<style is:inline>
  .header {
    --bg-color: var(--l-bg);
    --bg-color-opaque: var(--l-bg-opaque);
    --text-color: var(--l-text);
    --accent-color: var(--l-accent);
    --backdrop-blur: var(--l-blur);

    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    padding: 1em 2em;
    background-color: var(--bg-color);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    color: var(--text-color);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;

    @media (width < 768px) {
      align-self: flex-end;
      padding: 0.4em;
      margin: 0 auto;
    }
  }

  /* Automatic dark mode detection via root class */
  :root.dark .header:not(.header--force-light) {
    --bg-color: var(--d-bg);
    --bg-color-opaque: var(--d-bg-opaque);
    --text-color: var(--d-text);
    --accent-color: var(--d-accent);
    --backdrop-blur: var(--d-blur);
  }

  /* Forced themes */
  .header--force-dark {
    --bg-color: var(--d-bg) !important;
    --bg-color-opaque: var(--d-bg-opaque) !important;
    --text-color: var(--d-text) !important;
    --accent-color: var(--d-accent) !important;
    --backdrop-blur: var(--d-blur) !important;
  }

  .header--force-light {
    --bg-color: var(--l-bg) !important;
    --bg-color-opaque: var(--l-bg-opaque) !important;
    --text-color: var(--l-text) !important;
    --accent-color: var(--l-accent) !important;
    --backdrop-blur: var(--l-blur) !important;
  }

  .header__container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    position: fixed;

    @media (width < 768px) {
      justify-content: flex-end;
      align-items: flex-end;
    }
  }

  .header__container--floating {
    padding: 0.5em;
  }

  .header__container--fullscreen {
    padding: 0;
  }

  .header--floating {
    max-width: 1100px;
    border-radius: 20px;
    padding: 0.7em 1em;

    @media (width < 768px) {
      max-width: 95%;
    }
  }

  .header--fullscreen {
    border-radius: 0;
    padding: 1em 2em;

    @media (width < 768px) {
      max-width: 100%;
      padding: 0.8em 1em;
    }
  }

  .logo__container {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    & span {
      font-weight: 600;
    }
  }

  .header__logo {
    margin-right: 1em;
    object-fit: contain;
  }

  .actions-desktop {
    @media (width < 768px) {
      display: none;
    }
  }

  .actions-mobile {
    margin-top: 20px;
    @media (width >= 768px) {
      display: none;
    }
  }

  .header--fullscreen .mobile-header__menu.is-active {
    transform: translate(0%);
  }
</style>
