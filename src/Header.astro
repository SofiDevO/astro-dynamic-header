---
import HamburgerButton from "./HamburgerButton.astro";
import NavMenu from "./NavMenu.astro";
import MobileNav from "./MobileNav.astro";

import type { NavConfig, HeaderClassNames } from "./index.js";

export interface Props {
  /**
   * Layout style of the header.
   * - `"floating"` — centered, max width, rounded corners (default).
   * - `"fullscreen"` — full width, no border radius.
   *
   * @default "floating"
   * @example
   * ```astro
   * <Header headerType="fullscreen" />
   * ```
   */
  headerType?: "floating" | "fullscreen";

  /**
   * Theme behavior of the header.
   * - `"auto"` (default) — follows the `.dark` class on the root element.
   * - `"light"` — always render the light theme (`header--force-light`).
   * - `"dark"` — always render the dark theme (`header--force-dark`).
   *
   * Colors are controlled with CSS variables (see the README "CSS variable
   * reference"), never with props.
   *
   * @default "auto"
   * @example
   * ```astro
   * <Header preset="dark" />
   * ```
   */
  preset?: "light" | "dark" | "auto";

  /**
   * Navigation links, home link, and fine-grained classes for the desktop
   * menu items.
   *
   * @example
   * ```astro
   * <Header
   *   navigation={{
   *     menuItems: [
   *       { link: "/about", text: "About" },
   *       { link: "/work", text: "Work", submenu: [{ link: "/ux", text: "UX" }] },
   *     ],
   *     menu__link__class: "hover:text-purple-400",
   *   }}
   * />
   * ```
   */
  navigation?: NavConfig;

  /**
   * CSS classes for the structural wrapper elements. The component styles
   * live in `@layer components`, so any class passed here — Tailwind
   * utilities included — wins over the built-in styles without `!important`.
   *
   * @example
   * ```astro
   * <Header classNames={{ header: "bg-red-500 shadow-xl", container: "top-4" }} />
   * ```
   *
   * With plain CSS, put your own class in `@layer utilities` so it beats the
   * component:
   *
   * ```astro
   * <Header classNames={{ header: "custom-header-bg" }} />
   * <style is:inline>
   *   @layer utilities {
   *     .custom-header-bg { background-color: red; }
   *   }
   * </style>
   * ```
   */
  classNames?: HeaderClassNames;
  headerBg?: string;

}

const {
  headerType = "floating",
  preset = "auto",
  navigation = {},
  classNames = {},
} = Astro.props;

if (import.meta.env.DEV) {
  const removedThemeProp = (Astro.props as Record<string, unknown>).theme;

  if (removedThemeProp !== undefined) {
    console.warn(
      "[@sofidevo/astro-dynamic-header] BREAKING CHANGE: The 'theme' prop was removed in v5. Set the same tokens as CSS variables instead: --l-bg / --d-bg, --l-bg-opaque / --d-bg-opaque, --l-text / --d-text, --l-accent / --d-accent, --l-blur / --d-blur, and --header-z-index for the container z-index. See the README 'CSS variable reference'.",
    );
  }

  if (Array.isArray(navigation)) {
    console.warn(
      "[@sofidevo/astro-dynamic-header] BREAKING CHANGE: The 'navigation' prop now expects an object with 'menuItems'. Please use navigation={{ menuItems: [...] }} instead.",
    );
  }
}

// Navigation configuration
const {
  homeUrl = "/",
  menuItems = [],
  header__menu__class,
  header__item__class,
  menu__link__class,
} = navigation;



const forcedClass = preset !== "auto" ? `header--force-${preset}` : "";
---

<style >
  @layer theme, base, components, utilities;
</style>

<script>
  import { initHamburger } from "./scripts/hamburger.js";
  import { initLayerDiagnostics } from "./scripts/layer-diagnostics.js";

  initHamburger();

  if (import.meta.env.DEV) {
    initLayerDiagnostics();
  }
</script>

<div
  class:list={[
    "header__container",
    `header__container--${headerType}`,
    classNames.container,
  ]}
>
  <header
    class:list={[
      classNames.header,
      "header",
      `header--${headerType}`,
      forcedClass,
    ]}
  >
    <slot name="logo" />

    <div class:list={[classNames.nav, "nav-menu-wrapper"]}>
      <NavMenu
        menuItems={menuItems}
        homeUrl={homeUrl}
        header__menu__class={header__menu__class}
        header__item__class={header__item__class}
        menu__link__class={menu__link__class}
      />
    </div>

    {
      Astro.slots.has("actions") && (
        <div class="actions-desktop">
          <slot name="actions" />
        </div>
      )
    }

    <HamburgerButton />

    <MobileNav
      menuItems={menuItems}
      homeUrl={homeUrl}
      type={headerType}
      mobileNav__class={classNames.mobileNav}
    >
      {
        Astro.slots.has("actions") && (
          <div class="actions-mobile" slot="slot-panel">
            <slot name="actions" />
          </div>
        )
      }
    </MobileNav>
  </header>
</div>

<style >
  /*
   * Cascade layers keep this component overridable:
   *   base (resets/preflight) < components (ours) < utilities (your classNames)
   * The order statement below fixes that order before any layer of ours is
   * used; the dev-only diagnostic warns when a consumer's CSS created the
   * layers in a different order first. No `!important` is needed to override us.
   */
  @layer theme, base, components, utilities;

  @layer components {
    .header {
      --bg-color: var(--l-bg);
      --bg-color-opaque: var(--l-bg-opaque, rgba(255, 255, 255, 0.748));
      --text-color: var(--l-text, #1a1a1a);
      --accent-color: var(--l-accent, #3e1c71);
      --backdrop-blur: var(--l-blur, blur(20px));

      display: flex;
      align-items: center;
      width: 100%;
      justify-content: space-between;
      padding: 1em 2em;
      backdrop-filter: var(--backdrop-blur);
      -webkit-backdrop-filter: var(--backdrop-blur);
      color: var(--text-color);
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
        z-index: 200;

      @media (width < 768px) {
        align-self: flex-end;
        padding: 0.4em;
        margin: 0 auto;
      }
    }

    /* Automatic dark mode detection via root class */
    :root.dark .header:not(.header--force-light):not(.header--force-dark) {
      --bg-color: var(--d-bg, rgba(0, 0, 0, 0.823));
      --bg-color-opaque: var(--d-bg-opaque, #0d0d0d);
      --text-color: var(--d-text, #ffffff);
      --accent-color: var(--d-accent, #00ffff);
      --backdrop-blur: var(--d-blur, blur(20px));
    }

    /* Forced themes: higher specificity than .header, no !important needed */
    .header.header--force-dark {
      --bg-color: var(--d-bg, rgba(0, 0, 0, 0.823));
      --bg-color-opaque: var(--d-bg-opaque, #000000d9);
      --text-color: var(--d-text, #ffffff);
      --accent-color: var(--d-accent, #00ffff);
      --backdrop-blur: var(--d-blur, blur(30px));
    }

    .header.header--force-light {
      --bg-color: var(--l-bg,  rgba(255, 255, 255, 0.748));
      --bg-color-opaque: var(--l-bg-opaque, rgb(255, 255, 255));
      --text-color: var(--l-text, #1a1a1a);
      --accent-color: var(--l-accent, #3e1c71);
      --backdrop-blur: var(--l-blur, blur(30px));
    }

    .header__container {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 auto;
      position: fixed;
      z-index: var(--header-z-index, 10);

      @media (width < 768px) {
        justify-content: flex-end;
        align-items: flex-end;
      }
    }

    .header__container--floating {
      padding: 0.5em;
    }

    .header__container--fullscreen {
      padding: 0;
    }

    .header--floating {
      max-width: 1100px;
      border-radius: 20px;
      padding: 0.7em 1em;

      @media (width < 768px) {
        max-width: 95%;
      }
    }

    .header--fullscreen {
      border-radius: 0;
      padding:0.6rem 1em ;

      @media (width < 768px) {
        max-width: 100%;
        padding: 0.8em 1em;
      }
    }

    .actions-desktop {
      @media (width < 768px) {
        display: none;
      }
    }

    .actions-mobile {
      margin-top: 20px;

      @media (width >= 768px) {
        display: none;
      }
    }
  }
</style>
